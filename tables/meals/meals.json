{
  "name": "meals",
  "primary_key_column": "id",
  "enable_rls": true,
  "columns": [
    { "name": "name", "type": "TEXT", "required": true, "max_length": 160, "description": "What was eaten, e.g. 'Grilled chicken salad'" },
    { "name": "meal_type", "type": "ENUM", "required": true, "default": "snack",
      "options": ["breakfast", "lunch", "dinner", "snack"],
      "description": "Time-of-day category of the meal" },
    { "name": "logged_at", "type": "DATETIME", "required": true,
      "description": "When the meal was eaten (defaults to now on log)" },
    { "name": "calories", "type": "FLOAT", "description": "Total kcal for the portion logged" },
    { "name": "protein_g", "type": "FLOAT", "description": "Grams of protein" },
    { "name": "carbs_g", "type": "FLOAT", "description": "Grams of carbohydrates" },
    { "name": "fat_g", "type": "FLOAT", "description": "Grams of fat" },
    { "name": "quantity", "type": "FLOAT", "description": "Portion size number, e.g. 1.5 or 200" },
    { "name": "unit", "type": "TEXT", "max_length": 40, "description": "Portion unit, e.g. 'serving', 'g', 'ml', 'piece'" },
    { "name": "source", "type": "ENUM", "required": true, "default": "manual",
      "options": ["manual", "telegram"],
      "description": "How the meal was logged" },
    { "name": "notes", "type": "TEXT", "description": "Free-text notes about the meal" },
    { "name": "raw_input", "type": "JSON", "description": "Original user input that produced this row (for audit/re-parse)" },
    { "name": "image_path", "type": "FILE_PATH", "max_length": 700, "description": "Optional food photo in the user's /me tree" },
    { "name": "dedupe_key", "type": "TEXT", "unique": true, "max_length": 240 },
    { "name": "review_status", "type": "ENUM", "required": true, "default": "pending", "options": ["pending", "reviewed"] },
    { "name": "meal_score", "type": "INTEGER", "description": "Gentle 1-5 balance score, not a moral grade." },
    { "name": "protein_signal", "type": "ENUM", "options": ["low", "steady", "high"] },
    { "name": "plant_signal", "type": "ENUM", "options": ["none", "some", "strong"] },
    { "name": "needs_attention", "type": "BOOLEAN", "default": false },
    { "name": "review_note", "type": "TEXT", "max_length": 1200 },
    { "name": "next_move", "type": "TEXT", "max_length": 700 },
    { "name": "reviewed_at", "type": "DATETIME" }
  ],
  "config": {}
}
