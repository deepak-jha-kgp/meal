{
  "name": "meal_signals",
  "primary_key_column": "id",
  "enable_rls": true,
  "columns": [
    {
      "name": "meal_id",
      "type": "UUID",
      "foreign_key": { "references": "meals.id" }
    },
    { "name": "signal_type", "type": "ENUM", "required": true, "options": ["protein_gap", "low_confidence", "large_estimate", "pattern", "info"] },
    { "name": "severity", "type": "ENUM", "required": true, "default": "info", "options": ["info", "low", "medium", "high"] },
    { "name": "title", "type": "TEXT", "required": true, "max_length": 240 },
    { "name": "body", "type": "TEXT", "required": true, "max_length": 1200 },
    { "name": "status", "type": "ENUM", "required": true, "default": "open", "options": ["open", "acknowledged", "dismissed"] },
    { "name": "signal_key", "type": "TEXT", "unique": true, "max_length": 240 },
    { "name": "metadata", "type": "JSON" }
  ],
  "config": {}
}
